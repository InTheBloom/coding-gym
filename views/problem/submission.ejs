<% const ROOT = `${process.cwd()}/views`; %>
<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Submission #<%= submission.id %> - Coding gym</title>

</head>
<body>
    <header>
        <%- include(`${ROOT}/partials/header/sitename`) %>
    </header>
    <%- include(`${ROOT}/partials/messages`) %>

    <main>
        <h1>Submission #<%= submission.id %></h1>

        <p>User: <%= submission.username %></p>
        <p>Problem: <a href="/problem/<%= submission.problem_number %>"><%= submission.problem_number %>: <%= submission.title %></a></p>
        <p>Submitted at: <%= new Date(submission.submitted_at).toLocaleString("ja-JP") %></p>
        <p>Result: <%= submission.is_correct ? "Accepted" : "Wrong Answer" %></p>
        <p>Feedback: <%= submission.feedback %></p>

        <h2>Code</h2>
        <pre><code><%= submission.code %></code></pre>
    </main>
</body>
</html>
