<% const ROOT = `${process.cwd()}/views`; %>
<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Problem <%= problem.problem_number %>: <%= problem.title %> - Coding gym</title>

    <link rel="stylesheet" href="/stylesheets/katex/katex.min.css">

    <!-- フォームリセッター -->
    <script>addEventListener("pageshow", (e) => { document.querySelector("form")?.reset(); })</script>
</head>
<body>
    <header>
        <%- include(`${ROOT}/partials/header/sitename`) %>
        <nav>
            <a href="/problem">back to problem list</a>
            <a href="/problem/<%= problem.problem_number %>/submissions">see all submissions</a>
        </nav>
    </header>
    <%- include(`${ROOT}/partials/messages`) %>

    <main>
        <div class="problem-header">
            <h2>Problem <%= problem.problem_number %>: <%= problem.title %></h2>
            <div class="problem-meta">
                <span>Category: <%= problem.category %></span>
                <span>Points: <%= problem.points %></span>
                <span>Published: <%= new Date(problem.created_at).toLocaleDateString("ja-JP") %></span>
            </div>
        </div>

        <div class="problem-description">
            <div>
                <%- problem.description %>
            </div>
        </div>

        <div class="sample-input">
            <h3>入力例</h3>
            <% if (problem.sample_input) { %>
                <pre><code><%= problem.sample_input %></code></pre>
            <% } else { %>
                <p>入力は与えられません。</p>
            <% } %>
        </div>
        <div class="sample-output">
            <h3>出力例</h3>
            <% if (problem.sample_output) { %>
                <pre><code><%= problem.sample_output %></code></pre>
            <% } else { %>
                <p>出力はありません。</p>
            <% } %>
        </div>

        <div class="input">
            <h3>入力データ</h3>
            <% if (problem.testcase_input_file) { %>
                <a href="<%= problem.testcase_input_file %>" download>入力データをダウンロード</a>
            <% } else { %>
                <p>入力は与えられません。</p>
            <% } %>
        </div>

        <div class="answer-form">
            <h3>提出</h3>
            <form action="/problem/<%= problem.problem_number %>/submit" method="POST" enctype="multipart/form-data">
                <div>
                    <label for="answer">Answer File:</label>
                    <input type="file" id="answer_file" name="answer_file" required>
                </div>
                <div>
                    <label for="code">Code (optional):</label>
                    <textarea id="code" name="code" rows="10" cols="80" placeholder="Your solution code..."></textarea>
                </div>
                <div>
                    <button type="submit">Submit Answer</button>
                </div>
            </form>
        </div>

    </main>
</body>
</html>
